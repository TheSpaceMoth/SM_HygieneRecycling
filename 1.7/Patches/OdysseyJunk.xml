				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientShower"]/comps/li[@Class="DubsBadHygiene.CompProperties_Blockage"]</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientShower"]/comps</xpath>
						<value>
							<li Class="DubsBadHygiene.CompProperties_Blockage" />
						</value>
					</nomatch>
				</li>
				
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientShower"]/placeWorkers</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientShower"]</xpath>
						<value>
							<placeWorkers/>
						</value>
					</nomatch>
				</li>
				
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientShower"]/placeWorkers/li[@Class="DubsBadHygiene.PlaceWorker_SewageGrid"]</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientShower"]/placeWorkers</xpath>
						<value>
							<li>DubsBadHygiene.PlaceWorker_SewageGrid</li>
						</value>
					</nomatch>
				</li>
				
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientShower"]/socialPropernessMatters</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientShower"]</xpath>
						<value>		
							<socialPropernessMatters>true</socialPropernessMatters>
						</value>
					</nomatch>
					<match Class="PatchOperationReplace">
						<xpath>Defs/ThingDef[defName="AncientShower"]/socialPropernessMatters</xpath>
						<value>		
							<socialPropernessMatters>true</socialPropernessMatters>
