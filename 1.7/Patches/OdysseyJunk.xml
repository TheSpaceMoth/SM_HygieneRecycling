				</li>								
				
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientShower"]/comps</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientShower"]</xpath>
