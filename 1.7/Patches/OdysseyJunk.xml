					</nomatch>
				</li>
				
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientShower"]/comps/li[@Class="CompProperties_Forbiddable"]</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientShower"]/comps</xpath>
						<value>
							<li Class="CompProperties_Forbiddable" />
