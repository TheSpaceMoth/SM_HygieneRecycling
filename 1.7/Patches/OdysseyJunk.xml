					</nomatch>
				</li>
										
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientShower"]/hasInteractionCell</xpath>
					<match Class="PatchOperationReplace">
						<xpath>Defs/ThingDef[defName="AncientShower"]/hasInteractionCell</xpath>
						<value>
							<hasInteractionCell>false</hasInteractionCell>
						</value>
					</match>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientShower"]</xpath>
						<value>
							<hasInteractionCell>false</hasInteractionCell>
						</value>
					</nomatch>
				</li>
								
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientShower"]/thingClass</xpath>
					<match Class="PatchOperationReplace">
						<xpath>Defs/ThingDef[defName="AncientShower"]/thingClass</xpath>
						<value>
							<thingClass>DubsBadHygiene.Building_Shower</thingClass>
						</value>
					</match>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientShower"]</xpath>
						<value>
							<thingClass>DubsBadHygiene.Building_Shower</thingClass>
						</value>
					</nomatch>
				</li>
				
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientShower"]/hasInteractionCell</xpath>
					<match Class="PatchOperationReplace">
						<xpath>Defs/ThingDef[defName="AncientShower"]/hasInteractionCell</xpath>
						<value>
							<hasInteractionCell>false</hasInteractionCell>
						</value>
					</match>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientShower"]</xpath>
						<value>
