<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<!-- For the hygiene functionality. Might be added by other mods -->
	
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="AncientBathtub"]</xpath>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientBathtub"]/comps</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientBathtub"]</xpath>
						<value>
							<comps/>
						</value>
					</nomatch>
				</li>
						
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientBathtub"]/comps/li[@Class="DubsBadHygiene.CompProperties_Pipe"]</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientBathtub"]/comps</xpath>
						<value>
							<li Class="DubsBadHygiene.CompProperties_Pipe">
								<mode>Sewage</mode>
							</li>
						</value>
					</nomatch>
				</li>
				
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientBathtub"]/comps/li[@Class="CompProperties_Forbiddable"]</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientBathtub"]/comps</xpath>
						<value>
							<li Class="CompProperties_Forbiddable" />
						</value>
					</nomatch>
				</li>
				
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientBathtub"]/comps/li[@Class="DubsBadHygiene.CompProperties_Blockage"]</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientBathtub"]/comps</xpath>
						<value>
							<li Class="DubsBadHygiene.CompProperties_Blockage" />
						</value>
					</nomatch>
				</li>
				
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientBathtub"]/placeWorkers</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientBathtub"]</xpath>
						<value>
							<placeWorkers/>
						</value>
					</nomatch>
				</li>
				
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientBathtub"]/placeWorkers/li[@Class="DubsBadHygiene.PlaceWorker_SewageGrid"]</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientBathtub"]/placeWorkers</xpath>
						<value>
							<li>DubsBadHygiene.PlaceWorker_SewageGrid</li>
						</value>
					</nomatch>
				</li>
				
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientBathtub"]/socialPropernessMatters</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientBathtub"]</xpath>
						<value>		
							<socialPropernessMatters>true</socialPropernessMatters>
						</value>
					</nomatch>
					<match Class="PatchOperationReplace">
						<xpath>Defs/ThingDef[defName="AncientBathtub"]/socialPropernessMatters</xpath>
						<value>		
							<socialPropernessMatters>true</socialPropernessMatters>
						</value>					
					</match>
				</li>								
				
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientBathtub"]/comps</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientBathtub"]</xpath>
						<value>
							<comps/>
						</value>
					</nomatch>
				</li>
										
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientBathtub"]/hasInteractionCell</xpath>
					<match Class="PatchOperationReplace">
						<xpath>Defs/ThingDef[defName="AncientBathtub"]/hasInteractionCell</xpath>
						<value>
							<hasInteractionCell>false</hasInteractionCell>
						</value>
					</match>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientBathtub"]</xpath>
						<value>
							<hasInteractionCell>false</hasInteractionCell>
						</value>
					</nomatch>
				</li>
								
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientBathtub"]/thingClass</xpath>
					<match Class="PatchOperationReplace">
						<xpath>Defs/ThingDef[defName="AncientBathtub"]/thingClass</xpath>
						<value>
							<thingClass>DubsBadHygiene.Building_bath</thingClass>
						</value>
					</match>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientBathtub"]</xpath>
						<value>
							<thingClass>DubsBadHygiene.Building_bath</thingClass>
						</value>
					</nomatch>
				</li>
				
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="AncientBathtub"]/hasInteractionCell</xpath>
					<match Class="PatchOperationReplace">
						<xpath>Defs/ThingDef[defName="AncientBathtub"]/hasInteractionCell</xpath>
						<value>
							<hasInteractionCell>false</hasInteractionCell>
						</value>
					</match>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AncientBathtub"]</xpath>
						<value>
							<hasInteractionCell>false</hasInteractionCell>
						</value>
					</nomatch>
				</li>
			</operations>
		</match>
	</Operation>		

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="AncientShower"]</xpath>
