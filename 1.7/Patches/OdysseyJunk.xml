						</value>
					</nomatch>
				</li>
			</operations>
		</match>
	</Operation>
		
	<!-- For the minify functionality. Might be added by other mods -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/ThingDef[defName="AncientBathtub"]/minifiedDef</xpath>
		<nomatch Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd" MayRequire="ludeon.rimworld.odyssey">
					<xpath>/Defs/ThingDef[defName="AncientBathtub"]</xpath>
					<value>
						<thingCategories>
							<li>BuildingsHygiene</li>
						</thingCategories>
						<minifiedDef>MinifiedThing</minifiedDef>
						<rotatable>true</rotatable>
					</value>
				</li>
				<li Class="PatchOperationAdd" MayRequire="ludeon.rimworld.odyssey">
					<xpath>/Defs/ThingDef[defName="AncientBathtub"]/statBases</xpath>
					<value>
						<Mass>15</Mass>
						<Comfort>-3</Comfort>
					</value>
				</li>
			</operations>
		</nomatch>
	</Operation>
	
	<Operation Class="PatchOperationConditional" MayRequire="ludeon.rimworld.odyssey">
		<xpath>/Defs/ThingDef[defName="AncientShower"]/minifiedDef</xpath>
		<nomatch Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd" MayRequire="ludeon.rimworld.odyssey">
					<xpath>/Defs/ThingDef[defName="AncientShower"]</xpath>
					<value>
						<thingCategories>
							<li>BuildingsHygiene</li>
						</thingCategories>
						<minifiedDef>MinifiedThing</minifiedDef>
					</value>
				</li>
				<li Class="PatchOperationAdd" MayRequire="ludeon.rimworld.odyssey">
					<xpath>/Defs/ThingDef[defName="AncientShower"]/statBases</xpath>
					<value>
						<Mass>15</Mass>
						<Comfort>-1</Comfort>
					</value>
				</li>
			</operations>
		</nomatch>
	</Operation>
	
	<!-- Finally update the descriptions to make things interesting. This will override so no checks needed -->
	<Operation Class="PatchOperationSequence">
		<operations>			
			<li Class="PatchOperationReplace" MayRequire="ludeon.rimworld.odyssey">
				<xpath>/Defs/ThingDef[defName="AncientBathtub"]/description</xpath>
				<value>
					<description>A bathtub with deep cracks and rust stains. It's barely usable but leaks.</description>
				</value>
			</li>
			<li Class="PatchOperationReplace" MayRequire="ludeon.rimworld.odyssey">
				<xpath>/Defs/ThingDef[defName="AncientShower"]/description</xpath>
				<value>
					<description>A heavily damaged shower stall. The plumbing leaks and the ceramics are shattered.</description>
				</value>
			</li>
			<!-- etc -->
		</operations>
	</Operation>
	
</Patch>
